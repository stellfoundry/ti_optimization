#!/usr/bin/env bash

GX_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v module >/dev/null 2>&1; then
  if [[ -f /opt/cray/pe/lmod/lmod/init/bash ]]; then
    GX_CONFIG_RESTORE_NOUNSET=0
    if [[ $- == *u* ]]; then
      GX_CONFIG_RESTORE_NOUNSET=1
      set +u
    fi
    # shellcheck disable=SC1091
    source /opt/cray/pe/lmod/lmod/init/bash
    if [[ ${GX_CONFIG_RESTORE_NOUNSET} -eq 1 ]]; then
      set -u
    fi
    unset GX_CONFIG_RESTORE_NOUNSET
  fi
fi

if ! command -v module >/dev/null 2>&1; then
  echo "module command not found; cannot prepare the GX module stack." >&2
  return 1 2>/dev/null || exit 1
fi


module reset >/dev/null 2>&1 || module purge >/dev/null 2>&1 || true
export GK_SYSTEM="${GK_SYSTEM:-perlmutter}"
module load gcc-native/14
module load PrgEnv-gnu/8.7.0
module load nvidia-mixed/26.5
module load cudatoolkit/13.2
module load cray-mpich/9.1.0
module load nccl/2.29.2-cu13
module load cray-hdf5-parallel/1.14.3.9
module load cray-netcdf-hdf5parallel/4.9.2.3
export MPICH_GPU_SUPPORT_ENABLED="${MPICH_GPU_SUPPORT_ENABLED:-0}"
export FI_CXI_RDZV_GET_MIN="${FI_CXI_RDZV_GET_MIN:-0}"
export FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD="${FI_CXI_SAFE_DEVMEM_COPY_THRESHOLD:-16777216}"
export GX_PATH="${GX_PATH:-${GX_CONFIG_DIR}/gx}"
